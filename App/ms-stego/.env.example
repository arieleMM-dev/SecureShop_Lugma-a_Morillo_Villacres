AUTH_BASE_URL=https://localhost:3443
AUTH_CA_PATH=secrets/ca.crt
AUTH_PUBLIC_KEY_PATH=secrets/jwt-public.pem
AUTH_SERVICE_TOKEN=CHANGE_ME_FROM_AUTH
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=chat-backend
AUTH_TIMEOUT=3
DATA_DIR=data
MAX_FILE_BYTES=5242880
MAX_PIXELS=4194304
MAX_DIMENSION=2048
WORKER_TIMEOUT=10
WORKER_MEMORY_MB=512
MAX_JOBS=2
QUARANTINE_DAYS=7
REQUIRE_SANDBOX=true
