NODE_ENV=development
PORT=3001
AUTH_INTERNAL_PORT=3443
AUTH_BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=user_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_DATABASE=user_db
DB_SSL=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=auth-service
JWT_AUDIENCE=chat-backend
AUTH_TLS_CERT_PATH=secrets/auth-tls.crt
AUTH_TLS_KEY_PATH=secrets/auth-tls.key
STEGO_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN
SEED_PASSWORD=CHANGE_ME_SEED_PASSWORD
