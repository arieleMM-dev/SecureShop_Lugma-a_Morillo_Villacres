    "/internal/authorization/check": {
      "post": {
        "operationId": "InternalAuthorizationController_check",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckAuthorizationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decisión actual, allowed true o false; no constituye permiso permanente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "subject_id",
                    "action",
                    "resource_id",
                    "allowed",
                    "reason"
                  ],
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "steganography.analyze",
                        "steganography.results.read"
                      ]
                    },
                    "resource_id": {
                      "type": "string",
                      "format": "uuid",
                      "nullable": true
                    },
                    "allowed": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "active_role_grants_permission",
                        "active_role_does_not_grant_permission"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Servicio, canal o token de usuario inválido"
          }
        },
        "security": [
          {
            "ServiceToken": []
          }
        ],
        "summary": "Decisión vigente para STEGO sobre TLS; resource_owner_id procede del registro del análisis en STEGO",
        "tags": [
          "Autorización interna"
        ]
      }
    }
