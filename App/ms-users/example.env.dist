NODE_ENV=development

PORT=3001

CORS_ORIGINS=http://localhost:3000

# Solamente configurar si existe un proxy/gateway confiable
TRUST_PROXY=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=user_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_DATABASE=user_db

DB_SSL=false

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000


JWT_SECRET=CHANGE_ME_WITH_A_SECURE_RANDOM_SECRET
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=user-service
JWT_AUDIENCE=secure-shop-api
# Se genera localmente con npm run env:init
SEED_PASSWORD=
